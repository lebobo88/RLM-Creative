{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo RLM-Creative studio -- 8 Garland heads loaded",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File plugins/rlm-creative/hooks/pre-asset-write.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File plugins/rlm-creative/hooks/post-render-validate.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
